{
  "_comment": "启用 MISRA addon 的配置档。用法: python run_check.py <target> --config checker/config.misra.json",
  "enabled_checkers": ["cppcheck", "custom-regex"],
  "fail_on": ["error", "warning"],

  "cppcheck": {
    "enable": "warning,style,performance,portability",
    "std": "c11",
    "timeout": 180,
    "includes": [],
    "rule_file": null,
    "misra_addon": "checker/addons/misra.py"
  },

  "custom_regex": {
    "enabled": true,
    "rules": [
      {
        "id": "no-goto", "rule": "CTRL-1", "severity": "warning",
        "pattern": "(^|[^A-Za-z0-9_])goto\\s",
        "message": "禁止使用 goto（MISRA Rule 15.1）。"
      }
    ]
  }
}
