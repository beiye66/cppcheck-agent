{
  "_comment": "检查框架配置。改这里即可启停检查器、调规则集，无需改代码。",
  "enabled_checkers": ["cppcheck", "custom-regex"],
  "fail_on": ["error", "warning"],

  "cppcheck": {
    "enable": "warning,style,performance,portability",
    "std": "c11",
    "timeout": 120,
    "includes": [],
    "rule_file": null,
    "misra_addon": null
  },

  "custom_regex": {
    "enabled": true,
    "rules": [
      {
        "id": "no-goto",
        "rule": "COMMON-1",
        "severity": "warning",
        "pattern": "(^|[^A-Za-z0-9_])goto\\s",
        "message": "禁止使用 goto（结构化编程规范 / MISRA Rule 15.1）。"
      },
      {
        "id": "no-magic-number",
        "rule": "COMMON-2",
        "severity": "style",
        "pattern": "[^A-Za-z0-9_.\"]([0-9]{2,})(?![0-9.eExXfFuUlL])",
        "message": "疑似魔法数字，建议用具名常量/宏替代。"
      },
      {
        "id": "leftover-todo",
        "rule": "COMMON-3",
        "severity": "information",
        "pattern": "//.*\\b(TODO|FIXME|XXX|HACK)\\b",
        "message": "代码中残留 TODO/FIXME 等标记。"
      },
      {
        "id": "no-tab-indent",
        "rule": "STYLE-1",
        "severity": "style",
        "pattern": "^\\t",
        "message": "使用了 Tab 缩进，规范要求空格缩进。"
      },
      {
        "id": "unsafe-func",
        "rule": "API-2",
        "severity": "warning",
        "pattern": "(^|[^A-Za-z0-9_])(gets|strcpy|strcat|sprintf)\\s*\\(",
        "message": "使用了不安全的库函数，建议改用带长度限制的安全版本（如 snprintf/strncpy）。"
      }
    ]
  }
}
